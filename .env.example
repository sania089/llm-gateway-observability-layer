# Copy to .env and fill in. Never commit .env.
POSTGRES_DB=gateway
POSTGRES_USER=gateway
POSTGRES_PASSWORD=change-me
GRAFANA_ADMIN_PASSWORD=change-me

# Provider keys (free tiers: Google AI Studio and Groq, both OpenAI-compatible)
GEMINI_API_KEY=
GROQ_API_KEY=

# Secret that guards /admin/v1/** (creating gateway API keys). Leave blank to disable the admin API.
GATEWAY_ADMIN_KEY=

# Optional free-tier guards (local limits kept just under each provider's quota)
# GEMINI_RPM=10
# GEMINI_MAX_CONCURRENT=4
# GROQ_RPM=25
# GROQ_MAX_CONCURRENT=4
# GATEWAY_MAX_INPUT_CHARS=100000
# GATEWAY_MAX_OUTPUT_TOKENS=2048
